---
import DownloadButton from '../DownloadButton.astro';
import { getLocale, useDict } from '../../i18n';

interface Props {
  eyebrow: string;
  heading: string;
  lead: string;
  /** Sent with the download click, e.g. `use-case-meetings`. */
  placement: string;
}

const { eyebrow, heading, lead, placement } = Astro.props;
const t = useDict(getLocale(Astro));
const hasVisual = Astro.slots.has('default');
---

<section class:list={['hero', { solo: !hasVisual }]}>
  <div class="aura" aria-hidden="true"></div>
  <div class="inner">
    <div class="copy">
      <span class="pill">{eyebrow}</span>
      <h1>{heading}</h1>
      <p class="lead">{lead}</p>
      <div><DownloadButton placement={placement} /></div>
      <p class="note">{t.hero.note}</p>
    </div>
    {hasVisual && <div class="visual"><slot /></div>}
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 72px 24px 88px;
  }
  .aura {
    position: absolute;
    right: -160px;
    top: -120px;
    width: 900px;
    height: 900px;
    border-radius: 50%;
    background: var(--aura-grad);
  }
  .inner {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 56px;
  }
  .copy {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .solo .copy {
    max-width: 820px;
  }
  .pill {
    align-self: flex-start;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--sage-soft);
    color: var(--success);
    font-size: 14px;
    font-weight: 600;
  }
  h1 {
    margin: 0;
    font-size: clamp(38px, 5.2vw, 62px);
    line-height: 1.06;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .lead {
    margin: 0;
    max-width: 580px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--text-2);
  }
  .note {
    margin: 0;
    font-size: 14px;
    color: var(--text-2);
  }
  .visual {
    flex: 0 1 360px;
    min-width: min(300px, 100%);
    display: flex;
    justify-content: center;
  }
  @media (max-width: 700px) {
    .hero {
      padding: 44px 20px 60px;
    }
    .inner {
      gap: 44px;
    }
  }
</style>
