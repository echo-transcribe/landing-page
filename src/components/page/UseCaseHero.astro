---
// The top of a use-case page. Unlike the home hero it leads with where you are
// (the use-case tabs) and the problem this case solves, and leaves the phone for later.
import DownloadButton from '../DownloadButton.astro';
import { getLocale, linkTo, useDict } from '../../i18n';
import { relatedRoutes, useCaseIds, type UseCaseId } from '../../i18n/pages';
import { useCaseIcons } from '../../lib/useCaseIcons';

interface Props {
  id: UseCaseId;
  heading: string;
  lead: string;
  problemTitle: string;
  problem: string;
}

const { id, heading, lead, problemTitle, problem } = Astro.props;
const locale = getLocale(Astro);
const t = useDict(locale);
const tabs = useCaseIds.map((tabId) => ({
  id: tabId,
  href: linkTo(relatedRoutes[tabId], locale),
  label: t.useCases.items[tabId].title,
  icon: useCaseIcons[tabId],
}));
---

<section class="hero">
  <div class="inner">
    <nav class="tabs" aria-label={t.header.nav.useCases}>
      <a class="section-link" href={linkTo('/#use-cases', locale)}>{t.header.nav.useCases}</a>
      <span class="sep" aria-hidden="true">/</span>
      <ul>
        {
          tabs.map((tab) => (
            <li>
              <a href={tab.href} aria-current={tab.id === id ? 'page' : undefined}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={tab.icon} />
                {tab.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="body">
      <div class="title">
        <span class="icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={useCaseIcons[id]} />
        </span>
        <h1>{heading}</h1>
      </div>
      <p class="lead">{lead}</p>
      <div class="cta">
        <DownloadButton placement={`use-case-${id}`} />
        <p class="note">{t.hero.note}</p>
      </div>
    </div>
    <aside class="problem">
      <div class="problem-head">
        <span class="problem-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 8v4"></path><path d="M12 16h.01"></path></svg>
        </span>
        <h2>{problemTitle}</h2>
      </div>
      <p>{problem}</p>
    </aside>
  </div>
</section>

<style>
  .hero {
    background: var(--sunken);
    border-bottom: 1px solid var(--border);
    padding: 28px 24px 72px;
  }
  .inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: center;
    gap: 56px 64px;
  }
  .tabs {
    grid-column: 1 / -1;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    font-size: 15px;
  }
  .section-link {
    color: var(--text-2);
    text-decoration: none;
  }
  .section-link:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }
  .sep {
    color: var(--text-3);
  }
  .tabs ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 4px;
    list-style: none;
    border-radius: 999px;
    background: var(--page);
    box-shadow: var(--hairline-strong);
  }
  .tabs ul a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    color: var(--text-ctl);
    text-decoration: none;
    white-space: nowrap;
  }
  .tabs ul a:hover {
    background: var(--raised);
    color: var(--text);
  }
  .tabs ul a[aria-current='page'] {
    background: var(--accent-soft);
    color: var(--accent-text);
    font-weight: 600;
  }
  .body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }
  .title {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }
  .icon {
    flex: none;
    /* Centre the tile on the heading's first line. */
    margin-top: calc((1.08em - 56px) / 2);
    font-size: clamp(34px, 4.4vw, 52px);
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  h1 {
    margin: 0;
    font-size: clamp(34px, 4.4vw, 52px);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .lead {
    margin: 0;
    max-width: 640px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--text-2);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 6px;
  }
  .problem {
    border-radius: 22px;
    background: var(--card);
    box-shadow: var(--hairline), 0 1px 2px rgba(58, 49, 37, 0.06);
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .problem-head {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .problem-icon {
    flex: none;
    /* Centre the circle on the heading's first line (22px × 1.25). */
    margin-top: calc((27.5px - 36px) / 2);
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  .problem h2 {
    margin: 0;
    font-size: 22px;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .problem p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-2);
  }
  .note {
    margin: 0;
    font-size: 14px;
    color: var(--text-2);
  }
  @media (max-width: 960px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 700px) {
    .title {
      gap: 14px;
    }
    .icon {
      width: 44px;
      height: 44px;
      border-radius: 13px;
      margin-top: calc((1.08em - 44px) / 2);
    }
    .icon svg {
      width: 22px;
      height: 22px;
    }
    .problem {
      padding: 24px;
    }
    .hero {
      padding: 20px 20px 56px;
    }
    .inner {
      gap: 36px;
    }
    /* Three tabs don't fit a phone with their labels; let the row scroll sideways. */
    .tabs ul {
      flex-wrap: nowrap;
      max-width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }
  }
</style>
