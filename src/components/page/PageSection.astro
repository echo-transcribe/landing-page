---
// A plain band of a marketing page: an H2 and its content in a readable width.
interface Props {
  title: string;
  eyebrow?: string;
  /** `wide` for card grids, `narrow` for text and lists. */
  width?: 'wide' | 'narrow';
  tone?: 'plain' | 'sunken';
  id?: string;
}

const { title, eyebrow, width = 'wide', tone = 'plain', id } = Astro.props;
---

<section id={id} class:list={[tone]}>
  <div class:list={['inner', width]}>
    <div class="head">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h2>{title}</h2>
    </div>
    <slot />
  </div>
</section>

<style>
  section {
    padding: 72px 24px;
  }
  .sunken {
    background: var(--sunken);
  }
  .inner {
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .wide {
    max-width: 1200px;
  }
  .narrow {
    max-width: 820px;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  h2 {
    margin: 0;
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1.12;
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .inner > :global(p) {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-2);
    max-width: 720px;
  }
  @media (max-width: 700px) {
    section {
      padding: 56px 20px;
    }
    .inner {
      gap: 24px;
    }
  }
</style>
