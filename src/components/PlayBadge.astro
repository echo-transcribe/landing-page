---
import { Image } from 'astro:assets';
import badge from '../assets/google-play-badge.png';
import { site } from '../config/site';
import { getLocale, useDict } from '../i18n';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  /** Where the badge sits, sent with the click event. */
  placement: string;
  /** In the first screen (header, hero): load eagerly. Everything else lazy-loads. */
  aboveFold?: boolean;
}

const { size = 'md', placement, aboveFold = false } = Astro.props;
const t = useDict(getLocale(Astro));
// Heights from the design; width follows the official badge's 564x168 ratio.
const height = { sm: 44, md: 52, lg: 60 }[size];
const width = Math.round((height * 564) / 168);
---

<!-- Official Google Play badge, cropped to its visible area only; the surrounding layout keeps the required clear space. -->
<a href={site.playUrl} class="badge" data-event="play_click" data-placement={placement}>
  <Image
    src={badge}
    alt={t.common.playBadgeAlt}
    width={width}
    height={height}
    densities={[1, 2]}
    loading={aboveFold ? 'eager' : 'lazy'}
  />
</a>

<style>
  .badge {
    display: inline-flex;
    flex: none;
    border-radius: 8px;
  }
</style>
