---
import { site } from '../config/site';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  /** Where the badge sits, sent with the click event. */
  placement: string;
}

const { size = 'md', placement } = Astro.props;
---

<!-- TODO before launch: replace the mark slot with Google's official badge artwork (brand rules). -->
<a
  href={site.playUrl}
  class:list={['badge', size]}
  aria-label="Get it on Google Play"
  data-event="play_click"
  data-placement={placement}
>
  <span class="mark" aria-hidden="true"></span>
  <span class="text">
    <span class="small">Get it on</span>
    <span class="big">Google Play</span>
  </span>
</a>

<style>
  .badge {
    --h: 52px;
    --pad-r: 17px;
    --pad-l: 10px;
    --gap: 9px;
    --radius: 8px;
    --mark: 29px;
    --small: 10px;
    --big: 21px;
    --line-gap: 3px;

    display: inline-flex;
    align-items: center;
    gap: var(--gap);
    height: var(--h);
    padding: 0 var(--pad-r) 0 var(--pad-l);
    border-radius: var(--radius);
    background: #000;
    color: #fff;
    text-decoration: none;
    box-shadow: inset 0 0 0 1px #a6a6a6;
    flex: none;
  }
  .badge:hover {
    color: #fff;
  }
  .lg {
    --h: 60px;
    --pad-r: 19px;
    --pad-l: 12px;
    --gap: 10px;
    --radius: 10px;
    --mark: 34px;
    --small: 11px;
    --big: 24px;
  }
  .sm {
    --h: 44px;
    --pad-r: 14px;
    --pad-l: 9px;
    --gap: 7px;
    --radius: 7px;
    --mark: 25px;
    --small: 8px;
    --big: 18px;
    --line-gap: 2px;
  }
  .mark {
    width: var(--mark);
    height: var(--mark);
    flex: none;
    border-radius: 4px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.45);
  }
  .text {
    display: flex;
    flex-direction: column;
    line-height: 1;
    gap: var(--line-gap);
  }
  .small {
    font-size: var(--small);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .big {
    font-size: var(--big);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
</style>
