---
import { Image } from 'astro:assets';
import en from '../assets/google-play-badge-en.png';
import de from '../assets/google-play-badge-de.png';
import es from '../assets/google-play-badge-es.png';
import fr from '../assets/google-play-badge-fr.png';
import it from '../assets/google-play-badge-it.png';
import ptBr from '../assets/google-play-badge-pt-br.png';
import sl from '../assets/google-play-badge-sl.png';
import { site } from '../config/site';
import { getLocale, useDict, type Locale } from '../i18n';

// Google's official badges per language (play.google.com/intl/en_us/badges), trimmed to the visible area.
const badges: Record<Locale, ImageMetadata> = { en, de, es, fr, it, 'pt-br': ptBr, sl };

interface Props {
  size?: 'sm' | 'md' | 'lg';
  /** Where the badge sits, sent with the click event. */
  placement: string;
  /** In the first screen (header, hero): load eagerly. Everything else lazy-loads. */
  aboveFold?: boolean;
}

const { size = 'md', placement, aboveFold = false } = Astro.props;
const locale = getLocale(Astro);
const t = useDict(locale);
const badge = badges[locale];
// Heights from the design; width follows the badge's own ratio.
const height = { sm: 44, md: 52, lg: 60 }[size];
const width = Math.round((height * badge.width) / badge.height);
---

<!-- Official Google Play badge, cropped to its visible area only; the surrounding layout keeps the required clear space. -->
<a href={site.playUrl} class="badge" data-event="play_click" data-placement={placement}>
  <Image
    src={badge}
    alt={t.common.playBadgeAlt}
    width={width}
    height={height}
    densities={[1, 2]}
    loading={aboveFold ? 'eager' : 'lazy'}
  />
</a>

<style>
  .badge {
    display: inline-flex;
    flex: none;
    border-radius: 8px;
  }
</style>
