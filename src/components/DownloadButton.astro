---
import { site } from '../config/site';

interface Props {
  /** Where the button sits, sent with the click event. */
  placement: string;
}

const { placement } = Astro.props;
---

<a class="download" href={site.playUrl} data-event="play_click" data-placement={placement}>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"></path><path d="m7 10 5 5 5-5"></path><path d="M5 20h14"></path></svg>
  Download now
</a>

<style>
  .download {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 60px;
    padding: 0 30px 0 26px;
    border-radius: 999px;
    background: #d4a373;
    color: #2a2318;
    font-size: 18px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 2px 6px -1px rgba(58, 49, 37, 0.1);
    transition: background-color 0.15s ease;
  }
  .download:hover {
    background: #c8925e;
    color: #2a2318;
  }
  @media (prefers-reduced-motion: reduce) {
    .download {
      transition: none;
    }
  }
</style>
