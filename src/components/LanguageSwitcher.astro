---
import { enabledLocales, getLocale, localeInfo, localizePath, unlocalizePath, useDict } from '../i18n';

interface Props {
  placement: 'header' | 'menu' | 'footer';
}

const { placement } = Astro.props;
const locale = getLocale(Astro);
const t = useDict(locale);
const route = unlocalizePath(Astro.url.pathname.replace(/(^|\/)index\.html$/, '$1').replace(/\.html$/, '')) || '/';
const current = localeInfo(locale);
const code = current.htmlLang.split('-')[0].toUpperCase();
const label = placement === 'header' ? `${code}, ${t.languageSwitcher.label}: ${current.nativeName}` : `${t.languageSwitcher.label}: ${current.nativeName}`;
---

{
  enabledLocales.length > 1 && (
    <details class:list={['switcher', placement]}>
      <summary aria-label={label}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20"></path><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
        {placement === 'header' ? (
          <span class="code">{code}</span>
        ) : (
          <span lang={current.htmlLang}>{current.nativeName}</span>
        )}
      </summary>
      <ul>
        {enabledLocales.map((l) => (
          <li>
            <a
              href={localizePath(route, l.code)}
              hreflang={l.htmlLang}
              lang={l.htmlLang}
              aria-current={l.code === locale ? 'true' : undefined}
            >
              {l.nativeName}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}

<style>
  .switcher {
    position: relative;
    font-size: 15px;
  }
  summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    color: var(--text-ctl);
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    background: var(--raised);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 6px;
    min-width: 200px;
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    z-index: 20;
    background: var(--raised);
    border-radius: 14px;
    box-shadow:
      var(--hairline-strong),
      0 16px 32px -16px rgba(42, 35, 24, 0.25);
  }
  /* In the footer the switcher always has "No cookies…" to its right, so the list opens rightwards. */
  .footer ul {
    top: auto;
    bottom: calc(100% + 6px);
    right: auto;
    left: 0;
  }
  .code {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .menu {
    padding: 12px 0 0;
  }
  .menu ul {
    position: static;
    box-shadow: none;
    background: transparent;
    padding: 4px 0 0;
  }
  a {
    display: block;
    padding: 10px 12px;
    border-radius: 10px;
    color: var(--text-ctl);
    text-decoration: none;
  }
  a:hover {
    background: var(--sunken);
    color: var(--text);
  }
  a[aria-current='true'] {
    font-weight: 600;
    color: var(--text);
  }
</style>
