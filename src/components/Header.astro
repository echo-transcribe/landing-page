---
import { headerNav } from '../config/site';
import { getLocale, localizePath, useDict } from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import PlayBadge from './PlayBadge.astro';

const locale = getLocale(Astro);
const t = useDict(locale);
const links = headerNav
  .filter((l) => l.live)
  .map((l) => ({ href: localizePath(l.href, locale), label: t.header.nav[l.id as keyof typeof t.header.nav] }));
---

<header class="bar">
  <div class="inner">
    <Logo size="header" />
    <nav aria-label={t.header.navLabel} class="desktop-nav">
      {links.map((l) => <a href={l.href} class="nav-link">{l.label}</a>)}
    </nav>
    <div class="actions">
      <LanguageSwitcher placement="header" />
      <ThemeToggle />
      <span class="header-badge"><PlayBadge size="md" placement="header" aboveFold /></span>
      <button
        type="button"
        class="menu-btn"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.header.openMenu}
        data-label-open={t.header.openMenu}
        data-label-close={t.header.closeMenu}
        data-menu-toggle
      >
        <svg class="open-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16"></path><path d="M4 12h16"></path><path d="M4 17h16"></path></svg>
        <svg class="close-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12"></path><path d="M18 6L6 18"></path></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label={t.header.navLabel}>
      {links.map((l) => <a href={l.href} class="menu-link">{l.label}</a>)}
    </nav>
    <LanguageSwitcher placement="menu" />
    <div class="menu-badge"><PlayBadge size="md" placement="menu" /></div>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bar);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 18px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
  }
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav-link {
    padding: 12px 18px;
    font-size: 17px;
    font-weight: 500;
    color: var(--text-ctl);
    text-decoration: none;
    border-radius: 999px;
    white-space: nowrap;
  }
  .nav-link:hover {
    color: var(--text-ctl);
    background: rgba(127, 112, 90, 0.1);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .header-badge {
    display: contents;
  }

  .menu-btn {
    display: none;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    border: 0;
    background: transparent;
    color: var(--text-ctl);
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    flex: none;
  }
  .menu-btn:hover {
    background: var(--raised);
  }
  .close-icon,
  .menu-btn[aria-expanded='true'] .open-icon {
    display: none;
  }
  .menu-btn[aria-expanded='true'] .close-icon {
    display: block;
  }

  /* The panel drops down across the full width, directly under the bar. */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--page);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 16px 32px -16px rgba(42, 35, 24, 0.25);
    padding: 8px 16px 24px;
    max-height: calc(100dvh - 100%);
    overflow-y: auto;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu nav {
    display: flex;
    flex-direction: column;
  }
  .menu-link {
    padding: 14px 8px;
    font-size: 18px;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .menu-link:hover {
    color: var(--accent-hover);
  }
  .menu-badge {
    display: none;
    padding: 24px 8px 0;
  }

  @media (max-width: 1080px) {
    .desktop-nav {
      display: none;
    }
    .menu-btn {
      display: flex;
    }
    /* The mobile menu has its own language list. */
    .actions :global(.switcher.header) {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .inner {
      padding: 12px 16px;
    }
    .actions {
      gap: 8px;
    }
    .header-badge {
      display: none;
    }
    .menu-badge {
      display: block;
    }
  }
  @media (min-width: 1081px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', (open ? btn.dataset.labelClose : btn.dataset.labelOpen) ?? '');
    };

    btn.addEventListener('click', () => setOpen(menu.hasAttribute('hidden')));
    // Links are in-page anchors, so close the menu once one is followed.
    menu.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        btn.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!menu.hidden && !(e.target as Element).closest('.bar')) setOpen(false);
    });
    matchMedia('(min-width: 1081px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
