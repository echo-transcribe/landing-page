---
import { headerNav } from '../config/site';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import PlayBadge from './PlayBadge.astro';
---

<header class="bar">
  <div class="inner">
    <Logo size="header" />
    <nav aria-label="Main">
      {headerNav.filter((l) => l.live).map((l) => <a href={l.href} class="nav-link">{l.label}</a>)}
    </nav>
    <div class="actions">
      <ThemeToggle />
      <span class="header-badge"><PlayBadge size="md" placement="header" /></span>
    </div>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bar);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 18px 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
  }
  .nav-link {
    padding: 12px 18px;
    font-size: 17px;
    font-weight: 500;
    color: var(--text-ctl);
    text-decoration: none;
    border-radius: 999px;
    white-space: nowrap;
  }
  .nav-link:hover {
    color: var(--text-ctl);
    background: rgba(127, 112, 90, 0.1);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .header-badge {
    display: contents;
  }

  /* Below the 1440 design: nav drops to its own scrollable row. */
  @media (max-width: 1080px) {
    nav {
      order: 3;
      flex-basis: 100%;
      flex-wrap: nowrap;
      overflow-x: auto;
      margin: 0 -12px;
      scrollbar-width: none;
    }
    .nav-link {
      padding: 10px 14px;
      font-size: 16px;
    }
  }
  @media (max-width: 560px) {
    .inner {
      padding: 12px 16px;
      gap: 8px 16px;
    }
    .header-badge {
      display: none;
    }
    nav {
      margin: 0 -8px;
    }
  }
</style>
