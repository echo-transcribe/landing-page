---
import { Image } from 'astro:assets';
import mark from '../../assets/echo-mark.png';
import DownloadButton from '../DownloadButton.astro';
import { getLocale, useDict } from '../../i18n';

const t = useDict(getLocale(Astro));
---

<section>
  <div class="panel">
    <div class="glow" aria-hidden="true"></div>
    <Image class="mark" src={mark} alt="" width={72} height={70} densities={[1, 2]} loading="lazy" />
    <h2>{t.closingCta.title}</h2>
    <p class="sub">{t.closingCta.sub}</p>
    <div class="badge"><DownloadButton placement="cta" /></div>
    <ul class="facts">
      {t.closingCta.facts.map((fact) => <li>{fact}</li>)}
    </ul>
  </div>
</section>

<style>
  section {
    padding: 0 24px 104px;
  }
  .panel {
    position: relative;
    overflow: hidden;
    max-width: 1200px;
    margin: 0 auto;
    border-radius: 28px;
    background: var(--inverse);
    color: #fffdf5;
    /* In dark mode the panel is close to the page colour; the ring keeps its edge visible. */
    box-shadow: inset 0 0 0 1px rgba(255, 245, 220, 0.1);
    padding: clamp(40px, 6vw, 80px) 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
  }
  .glow {
    position: absolute;
    left: 50%;
    top: -260px;
    width: 720px;
    height: 520px;
    margin-left: -360px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(212, 163, 115, 0.3), rgba(212, 163, 115, 0));
  }
  .panel :global(.mark) {
    position: relative;
    object-fit: contain;
  }
  h2 {
    position: relative;
    margin: 0;
    font-size: clamp(32px, 4.4vw, 52px);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.03em;
    max-width: 720px;
  }
  .sub {
    position: relative;
    margin: -4px 0 4px;
    max-width: 560px;
    font-size: 18px;
    line-height: 1.55;
    color: #c9bea6;
  }
  .badge {
    position: relative;
  }
  .facts {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 20px;
    font-size: 14px;
    color: #a3967f;
  }
  .facts li {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .facts li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #b3c08e;
  }
  @media (max-width: 700px) {
    section {
      padding: 0 20px 72px;
    }
  }
</style>
