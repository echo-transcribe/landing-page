---
import SectionHeading from '../SectionHeading.astro';
import { site } from '../../config/site';
import { getLocale, useDict } from '../../i18n';

const t = useDict(getLocale(Astro));
const video = site.demoVideo;
---

<section id="how">
  <div class="inner">
    <SectionHeading eyebrow={t.howItWorks.eyebrow} title={t.howItWorks.title} />
    <ol>
      {
        t.howItWorks.steps.map((s, i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
    {
      video && (
        <figure class="demo">
          <video
            data-demo
            muted
            loop
            playsinline
            controls
            preload="none"
            poster={video.poster}
            width={video.width}
            height={video.height}
            aria-label={t.howItWorks.videoLabel}
          >
            {video.webm && <source src={video.webm} type="video/webm" />}
            <source src={video.mp4} type="video/mp4" />
          </video>
        </figure>
      )
    }
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-demo]');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  if (video && 'IntersectionObserver' in window) {
    video.controls = still.matches;
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !still.matches) video.play().catch(() => {});
      else video.pause();
    }, { threshold: 0.5 }).observe(video);
  }
</script>

<style>
  section {
    padding: 0 24px 104px;
  }
  .inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 16px;
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    border-radius: 18px;
    background: var(--cream);
  }
  .demo {
    margin: 0 auto;
    width: min(340px, 100%);
    border-radius: 40px;
    overflow: hidden;
    background: var(--frame);
    padding: 10px;
    box-shadow: 0 40px 80px -24px rgba(58, 49, 37, 0.35);
  }
  .demo video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 32px;
  }
  .num {
    font-size: 44px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--icon-accent);
    font-variant-numeric: tabular-nums;
  }
  h3 {
    margin: 0;
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-ctl);
  }
  @media (max-width: 700px) {
    section {
      padding: 0 20px 72px;
    }
    .inner {
      gap: 36px;
    }
  }
</style>
