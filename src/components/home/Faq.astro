---
import SectionHeading from '../SectionHeading.astro';
import FaqList from '../FaqList.astro';
import { getLocale, useDict } from '../../i18n';

const t = useDict(getLocale(Astro));
---

<section id="faq">
  <div class="inner">
    <SectionHeading eyebrow={t.faq.eyebrow} title={t.faq.title} />
    <FaqList items={t.faq.items} firstOpen />
  </div>
</section>

<style>
  section {
    padding: 104px 24px;
  }
  .inner {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  @media (max-width: 700px) {
    section {
      padding: 72px 20px;
    }
    .inner {
      gap: 32px;
    }
  }
</style>
