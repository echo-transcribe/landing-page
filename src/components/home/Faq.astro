---
import { product } from '../../config/product';
import SectionHeading from '../SectionHeading.astro';

const faqs = [
  {
    q: 'What happens after the free 2 minutes?',
    a: 'Your whole recording is saved, and the transcript stops at 2:00. Upgrade to Pro and Echo transcribes the rest of the same note.',
  },
  {
    q: 'Which phones does Echo run on?',
    a: `Android ${product.minAndroid} or newer. Summaries and tasks need about ${product.notesAiRamGb} GB of RAM. Phones with ${product.largeModelRamGb} GB or more get Whisper Large V3 Turbo, the most accurate speech model; others get a smaller, faster one.`,
  },
  {
    q: 'How accurate is it?',
    a: 'It depends on the audio: one clear voice close to the phone works best, crosstalk and background noise make it harder. Accuracy is highest in widely spoken languages.',
  },
  {
    q: 'Which languages get summaries and tasks?',
    a: `Transcription works in ${product.transcriptionLanguages} languages, and summaries and tasks are made for every one of them. The standard Notes AI writes them in English; the optional multilingual model writes them in the language of the note.`,
  },
  {
    q: 'Is Echo GDPR compliant?',
    a: 'Your recordings and notes are processed and stored on your device, so we never hold them. We are based in the EU, and the privacy policy lists the little data that is involved, such as Google Play purchases.',
  },
  {
    q: 'Which files can I import?',
    a: `Audio files such as ${product.importFormats}. Echo files each one under the day it was recorded, or today if you prefer.`,
  },
  {
    q: 'How do I move my notes to a new phone?',
    a: 'In Settings, choose Back up notes. Echo saves everything to one file you keep. Open it on the new phone to restore.',
  },
  { q: 'Is there an iPhone version?', a: 'Not yet. Echo is made for Android first.' },
];
---

<section id="faq">
  <div class="inner">
    <SectionHeading eyebrow="FAQ" title="Questions, answered" />
    <div class="list">
      {
        faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>
              {f.q}
              <svg class="faq-chev" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  section {
    padding: 104px 24px;
  }
  .inner {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  details {
    border-radius: 18px;
    background: var(--card);
    box-shadow: var(--hairline), 0 1px 2px rgba(58, 49, 37, 0.06);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    font-size: 17px;
    font-weight: 600;
  }
  .faq-chev {
    flex: none;
    color: var(--text-3);
    transition: transform 0.2s ease;
  }
  details[open] .faq-chev {
    transform: rotate(180deg);
  }
  details p {
    margin: 0;
    padding: 0 24px 22px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-2);
  }

  /* Height slide where supported (Chromium); other browsers open instantly but still get the fade below. */
  details {
    interpolate-size: allow-keywords;
  }
  details::details-content {
    height: 0;
    overflow: clip;
    transition:
      height 0.28s ease,
      content-visibility 0.28s allow-discrete;
  }
  details[open]::details-content {
    height: auto;
  }
  details[open] p {
    animation: faq-in 0.28s ease;
  }
  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-chev,
    details::details-content {
      transition: none;
    }
    details[open] p {
      animation: none;
    }
  }
  @media (max-width: 700px) {
    section {
      padding: 72px 20px;
    }
    .inner {
      gap: 32px;
    }
    summary {
      padding: 18px 20px;
    }
    details p {
      padding: 0 20px 20px;
    }
  }
</style>
