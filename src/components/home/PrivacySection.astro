---
import { getLocale, localizePath, useDict } from '../../i18n';

const locale = getLocale(Astro);
const t = useDict(locale);

// Same order as `t.privacySection.points`.
const icons = [
  '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>',
  '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="m17 8 5 5"></path><path d="m22 8-5 5"></path>',
  '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line>',
];
---

<section id="privacy">
  <div class="inner">
    <div class="heading">
      <div class="eyebrow-row">
        <span class="eyebrow">{t.privacySection.eyebrow}</span>
      </div>
      <h2>{t.privacySection.title}</h2>
      <p>{t.privacySection.lead}</p>
    </div>
    <div class="grid">
      {
        t.privacySection.points.map((p, i) => (
          <div class="card">
            <span class="icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i]} />
            </span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))
      }
    </div>
    <div class="site-note">
      <span class="site-title"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path><path d="m2 2 20 20"></path></svg>{t.privacySection.siteTitle}</span>
      <span class="site-text">{t.privacySection.siteText}</span>
      <a href={localizePath('/privacy', locale)} data-event="privacy_policy_click">{t.privacySection.policyLink}</a>
    </div>
  </div>
</section>

<style>
  section {
    background: var(--inverse);
    color: #fffdf5;
    padding: 104px 24px;
  }
  .inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .heading {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 760px;
  }
  .eyebrow-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #e0bb96;
  }
  h2 {
    margin: 0;
    font-size: clamp(32px, 4vw, 46px);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .heading p {
    margin: 0;
    font-size: 18px;
    line-height: 1.55;
    color: #d9d2c2;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 16px;
  }
  .card {
    border-radius: 18px;
    background: rgba(255, 253, 245, 0.06);
    box-shadow: inset 0 0 0 1px rgba(255, 245, 220, 0.1);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .icon {
    color: #e0bb96;
  }
  h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
  }
  .card p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: #d9d2c2;
  }
  .site-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    padding: 20px 24px;
    border-radius: 18px;
    background: rgba(255, 253, 245, 0.04);
    box-shadow: inset 0 0 0 1px rgba(255, 245, 220, 0.08);
  }
  .site-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 600;
  }
  .site-text {
    font-size: 15px;
    line-height: 1.5;
    color: #d9d2c2;
    flex: 1 1 420px;
  }
  .site-note a {
    font-size: 15px;
    font-weight: 600;
    color: #e0bb96;
  }
  .site-note a:hover {
    color: #fffdf5;
  }
  @media (max-width: 700px) {
    section {
      padding: 72px 20px;
    }
    .inner {
      gap: 36px;
    }
  }
</style>
