---
import SectionHeading from '../SectionHeading.astro';
import { getLocale, linkTo, useDict } from '../../i18n';
import { useCaseIcons } from '../../lib/useCaseIcons';

const locale = getLocale(Astro);
const t = useDict(locale);

// A card without `href` (no page yet) renders without a link.
const cases: { id: keyof typeof t.useCases.items; icon: string; href?: string }[] = [
  { id: 'meetings', href: linkTo('/use-cases/meetings', locale), icon: useCaseIcons.meetings },
  { id: 'lectures', href: linkTo('/use-cases/lectures', locale), icon: useCaseIcons.lectures },
  { id: 'interviews', href: linkTo('/use-cases/interviews', locale), icon: useCaseIcons.interviews },
  { id: 'subtitles', icon: useCaseIcons.subtitles },
];
---

<section id="use-cases">
  <div class="inner">
    <SectionHeading eyebrow={t.useCases.eyebrow} title={t.useCases.title} />
    <div class="grid">
      {
        cases.map((c) => {
          const copy = t.useCases.items[c.id];
          const Tag = c.href ? 'a' : 'div';
          return (
            <Tag class="card" href={c.href} data-event={c.href ? 'use_case_click' : undefined} data-use-case={c.href ? c.id : undefined}>
              <span class="icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.icon} />
              </span>
              <h3>{copy.title}</h3>
              <p>{copy.text}</p>
              {c.href && (
                <span class="more">
                  {t.useCases.learnMore}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                </span>
              )}
            </Tag>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  section {
    padding: 0 24px 104px;
  }
  .inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 16px;
  }
  .card {
    border-radius: 18px;
    background: var(--card);
    box-shadow: var(--hairline), 0 1px 2px rgba(58, 49, 37, 0.06);
    padding: 24px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    grid-template-rows: auto 1fr auto;
    gap: 10px 14px;
    text-decoration: none;
    color: var(--text);
  }
  a.card:hover {
    color: var(--text);
  }
  .icon {
    color: var(--icon-accent);
  }
  h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
  }
  p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-2);
    flex: 1;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-text);
  }
  @media (max-width: 700px) {
    section {
      padding: 0 20px 72px;
    }
    .inner {
      gap: 32px;
    }
  }
  .card p,
  .card .more {
    grid-column: 1 / -1;
    align-self: start;
  }
</style>
