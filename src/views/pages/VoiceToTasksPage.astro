---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/page/PageHero.astro';
import PageSection from '../../components/page/PageSection.astro';
import Cards from '../../components/page/Cards.astro';
import Related from '../../components/page/Related.astro';
import FaqList from '../../components/FaqList.astro';
import PhoneMockup from '../../components/PhoneMockup.astro';
import ClosingCta from '../../components/home/ClosingCta.astro';
import { usePages } from '../../i18n/pages';
import { faqSchema } from '../../i18n/pages/schema';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const p = usePages(locale);
const v = p.voiceToTasks;
---

<BaseLayout title={v.title} description={v.description} locale={locale} path="/features/voice-to-tasks" jsonLd={[faqSchema(v.faq, locale)]}>
  <PageHero eyebrow={v.eyebrow} heading={v.heading} lead={v.lead} placement="feature-voice-to-tasks">
    <PhoneMockup />
  </PageHero>
  <PageSection title={v.stepsTitle} tone="sunken">
    <Cards items={v.steps} numbered />
  </PageSection>
  <PageSection title={v.reminderTitle} width="narrow">
    <dl class="when">
      {
        v.reminders.map((r) => (
          <div>
            <dt>{r.when}</dt>
            <dd>{r.what}</dd>
          </div>
        ))
      }
    </dl>
    <p>{v.reminderNote}</p>
  </PageSection>
  <PageSection title={v.limitsTitle} width="narrow" tone="sunken">
    <ul class="limits">
      {v.limits.map((l) => <li>{l}</li>)}
    </ul>
  </PageSection>
  <PageSection title={p.common.faqTitle} eyebrow={p.common.faqEyebrow} width="narrow">
    <FaqList items={v.faq} />
  </PageSection>
  <PageSection title={p.common.relatedTitle}>
    <Related ids={v.related} />
  </PageSection>
  <ClosingCta />
</BaseLayout>

<style>
  .when {
    margin: 0;
    border-radius: 18px;
    background: var(--card);
    box-shadow: var(--hairline);
  }
  .when div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 24px;
    padding: 16px 22px;
  }
  .when div + div {
    border-top: 1px solid var(--rule);
  }
  dt {
    font-weight: 600;
  }
  dd {
    margin: 0;
    color: var(--text-2);
  }
  .limits {
    margin: 0;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .limits li {
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-ctl);
  }
</style>
