---

type Entry = { name: string; use: string; licence: string; url: string };

// Checked against the echo repo (gradle/libs.versions.toml, ModelStore.kt, WhisperModels.kt,
// SpeakerModels.kt, CMakeLists.txt) on 2026-11-18. Keep in sync when dependencies change.
const models: Entry[] = [
  { name: 'Whisper (Large V3 Turbo, Medium, Small, Base)', use: "Spracherkennung", licence: 'MIT', url: 'https://github.com/openai/whisper' },
  { name: 'Qwen3 1.7B and 0.6B', use: "Notes-KI", licence: 'Apache 2.0', url: 'https://huggingface.co/Qwen' },
  { name: 'Gemma 4 E2B', use: "Mehrsprachige Notes-KI (optional)", licence: 'Apache 2.0', url: 'https://ai.google.dev/gemma' },
  { name: 'Silero VAD', use: "Spracherkennung (Sprachaktivität)", licence: 'MIT', url: 'https://github.com/snakers4/silero-vad' },
  { name: 'pyannote segmentation 3.0', use: "Sprechererkennung", licence: 'MIT', url: 'https://huggingface.co/pyannote/segmentation-3.0' },
  { name: '3D-Speaker ERes2Net', use: "Sprechererkennung", licence: 'Apache 2.0', url: 'https://github.com/modelscope/3D-Speaker' },
];

const libraries: Entry[] = [
  { name: 'whisper.cpp / ggml', use: "Whisper-Engine auf dem Gerät", licence: 'MIT', url: 'https://github.com/ggml-org/whisper.cpp' },
  { name: 'sherpa-onnx', use: "Engine zur Sprechererkennung", licence: 'Apache 2.0', url: 'https://github.com/k2-fsa/sherpa-onnx' },
  { name: 'LiteRT-LM', use: "Notes-KI-Engine auf dem Gerät", licence: 'Apache 2.0', url: 'https://github.com/google-ai-edge/LiteRT-LM' },
  { name: 'Android Jetpack (AndroidX, Compose, Media3, WorkManager, Glance, Navigation)', use: "App-Framework", licence: 'Apache 2.0', url: 'https://developer.android.com/jetpack' },
  { name: 'SQLDelight', use: "Datenbank", licence: 'Apache 2.0', url: 'https://github.com/sqldelight/sqldelight' },
  { name: 'kotlinx.serialization', use: "Datenformat", licence: 'Apache 2.0', url: 'https://github.com/Kotlin/kotlinx.serialization' },
  { name: 'RevenueCat Purchases SDK', use: "Pro-Käufe", licence: 'MIT', url: 'https://github.com/RevenueCat/purchases-android' },
];

const website: Entry[] = [
  { name: 'Astro', use: "Website-Framework", licence: 'MIT', url: 'https://github.com/withastro/astro' },
  { name: 'DM Sans', use: "Schriftart", licence: 'SIL Open Font License 1.1', url: 'https://github.com/googlefonts/dm-fonts' },
  { name: 'qrcode', use: "QR-Code", licence: 'MIT', url: 'https://github.com/soldair/node-qrcode' },
];

const groups = [
  { id: 'models', title: "KI-Modelle in der App", entries: models },
  { id: 'libraries', title: "Bibliotheken in der App", entries: libraries },
  { id: 'website', title: "Diese Website", entries: website },
];
---

<p>
  Echo läuft dank offener Modelle und Open-Source-Software vollständig auf deinem Handy. Wir danken den Menschen, die sie entwickeln. Folge jedem Link für den vollständigen Lizenztext.
</p>
{
  groups.map((g) => (
    <section aria-labelledby={g.id}>
      <h2 id={g.id}>{g.title}</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Komponente</th>
              <th scope="col">Verwendet für</th>
              <th scope="col">Lizenz</th>
            </tr>
          </thead>
          <tbody>
            {g.entries.map((e) => (
              <tr>
                <td>
                  <a href={e.url}>{e.name}</a>
                </td>
                <td>{e.use}</td>
                <td>{e.licence}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))
}
