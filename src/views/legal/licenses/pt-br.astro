---

type Entry = { name: string; use: string; licence: string; url: string };

// Checked against the echo repo (gradle/libs.versions.toml, ModelStore.kt, WhisperModels.kt,
// SpeakerModels.kt, CMakeLists.txt) on 2026-11-18. Keep in sync when dependencies change.
const models: Entry[] = [
  { name: 'Whisper (Large V3 Turbo, Medium, Small, Base)', use: 'Reconhecimento de fala', licence: 'MIT', url: 'https://github.com/openai/whisper' },
  { name: 'Qwen3 1.7B and 0.6B', use: 'IA de notas', licence: 'Apache 2.0', url: 'https://huggingface.co/Qwen' },
  { name: 'Gemma 4 E2B', use: 'IA de notas multilíngue (opcional)', licence: 'Apache 2.0', url: 'https://ai.google.dev/gemma' },
  { name: 'Silero VAD', use: 'Detecção de atividade de voz', licence: 'MIT', url: 'https://github.com/snakers4/silero-vad' },
  { name: 'pyannote segmentation 3.0', use: 'Detecção de falantes', licence: 'MIT', url: 'https://huggingface.co/pyannote/segmentation-3.0' },
  { name: '3D-Speaker ERes2Net', use: 'Detecção de falantes', licence: 'Apache 2.0', url: 'https://github.com/modelscope/3D-Speaker' },
];

const libraries: Entry[] = [
  { name: 'whisper.cpp / ggml', use: 'Mecanismo Whisper no dispositivo', licence: 'MIT', url: 'https://github.com/ggml-org/whisper.cpp' },
  { name: 'sherpa-onnx', use: 'Mecanismo de detecção de falantes', licence: 'Apache 2.0', url: 'https://github.com/k2-fsa/sherpa-onnx' },
  { name: 'LiteRT-LM', use: 'Mecanismo de IA de notas no dispositivo', licence: 'Apache 2.0', url: 'https://github.com/google-ai-edge/LiteRT-LM' },
  { name: 'Android Jetpack (AndroidX, Compose, Media3, WorkManager, Glance, Navigation)', use: 'Framework do app', licence: 'Apache 2.0', url: 'https://developer.android.com/jetpack' },
  { name: 'SQLDelight', use: 'Banco de dados', licence: 'Apache 2.0', url: 'https://github.com/sqldelight/sqldelight' },
  { name: 'kotlinx.serialization', use: 'Formato de dados', licence: 'Apache 2.0', url: 'https://github.com/Kotlin/kotlinx.serialization' },
  { name: 'RevenueCat Purchases SDK', use: 'Compras do Pro', licence: 'MIT', url: 'https://github.com/RevenueCat/purchases-android' },
];

const website: Entry[] = [
  { name: 'Astro', use: 'Framework do site', licence: 'MIT', url: 'https://github.com/withastro/astro' },
  { name: 'DM Sans', use: 'Fonte tipográfica', licence: 'SIL Open Font License 1.1', url: 'https://github.com/googlefonts/dm-fonts' },
  { name: 'qrcode', use: 'Código QR', licence: 'MIT', url: 'https://github.com/soldair/node-qrcode' },
];

const groups = [
  { id: 'models', title: 'Modelos de IA no app', entries: models },
  { id: 'libraries', title: 'Bibliotecas no app', entries: libraries },
  { id: 'website', title: 'Este site', entries: website },
];
---

<p>
  O Echo roda inteiramente no seu celular graças a modelos abertos e a software de código aberto. Agradecemos às
  pessoas que os desenvolvem. Siga cada link para ver o texto completo da licença.
</p>
{
  groups.map((g) => (
    <section aria-labelledby={g.id}>
      <h2 id={g.id}>{g.title}</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Componente</th>
              <th scope="col">Usado para</th>
              <th scope="col">Licença</th>
            </tr>
          </thead>
          <tbody>
            {g.entries.map((e) => (
              <tr>
                <td>
                  <a href={e.url}>{e.name}</a>
                </td>
                <td>{e.use}</td>
                <td>{e.licence}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))
}
