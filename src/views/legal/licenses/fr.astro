---

type Entry = { name: string; use: string; licence: string; url: string };

// Checked against the echo repo (gradle/libs.versions.toml, ModelStore.kt, WhisperModels.kt,
// SpeakerModels.kt, CMakeLists.txt) on 2026-11-18. Keep in sync when dependencies change.
const models: Entry[] = [
  { name: 'Whisper (Large V3 Turbo, Medium, Small, Base)', use: "Reconnaissance vocale", licence: 'MIT', url: 'https://github.com/openai/whisper' },
  { name: 'Qwen3 1.7B and 0.6B', use: "IA des notes", licence: 'Apache 2.0', url: 'https://huggingface.co/Qwen' },
  { name: 'Gemma 4 E2B', use: "IA des notes multilingue (facultatif)", licence: 'Apache 2.0', url: 'https://ai.google.dev/gemma' },
  { name: 'Silero VAD', use: "Détection d'activité vocale", licence: 'MIT', url: 'https://github.com/snakers4/silero-vad' },
  { name: 'pyannote segmentation 3.0', use: "Détection des locuteurs", licence: 'MIT', url: 'https://huggingface.co/pyannote/segmentation-3.0' },
  { name: '3D-Speaker ERes2Net', use: "Détection des locuteurs", licence: 'Apache 2.0', url: 'https://github.com/modelscope/3D-Speaker' },
];

const libraries: Entry[] = [
  { name: 'whisper.cpp / ggml', use: "Moteur Whisper sur l'appareil", licence: 'MIT', url: 'https://github.com/ggml-org/whisper.cpp' },
  { name: 'sherpa-onnx', use: "Moteur de détection des locuteurs", licence: 'Apache 2.0', url: 'https://github.com/k2-fsa/sherpa-onnx' },
  { name: 'LiteRT-LM', use: "Moteur d'IA des notes sur l'appareil", licence: 'Apache 2.0', url: 'https://github.com/google-ai-edge/LiteRT-LM' },
  { name: 'Android Jetpack (AndroidX, Compose, Media3, WorkManager, Glance, Navigation)', use: "Framework de l'application", licence: 'Apache 2.0', url: 'https://developer.android.com/jetpack' },
  { name: 'SQLDelight', use: "Base de données", licence: 'Apache 2.0', url: 'https://github.com/sqldelight/sqldelight' },
  { name: 'kotlinx.serialization', use: "Format de données", licence: 'Apache 2.0', url: 'https://github.com/Kotlin/kotlinx.serialization' },
  { name: 'RevenueCat Purchases SDK', use: "Achats Pro", licence: 'MIT', url: 'https://github.com/RevenueCat/purchases-android' },
];

const website: Entry[] = [
  { name: 'Astro', use: "Framework du site", licence: 'MIT', url: 'https://github.com/withastro/astro' },
  { name: 'DM Sans', use: "Police de caractères", licence: 'SIL Open Font License 1.1', url: 'https://github.com/googlefonts/dm-fonts' },
  { name: 'qrcode', use: "Code QR", licence: 'MIT', url: 'https://github.com/soldair/node-qrcode' },
];

const groups = [
  { id: 'models', title: "Modèles d'IA dans l'application", entries: models },
  { id: 'libraries', title: "Bibliothèques dans l'application", entries: libraries },
  { id: 'website', title: "Ce site web", entries: website },
];
---

<p>
  Echo fonctionne entièrement sur votre téléphone grâce à des modèles ouverts et à des logiciels open source. Nous remercions les personnes qui les développent. Suivez chaque lien pour consulter le texte complet de la licence.
</p>
{
  groups.map((g) => (
    <section aria-labelledby={g.id}>
      <h2 id={g.id}>{g.title}</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Composant</th>
              <th scope="col">Utilisé pour</th>
              <th scope="col">Licence</th>
            </tr>
          </thead>
          <tbody>
            {g.entries.map((e) => (
              <tr>
                <td>
                  <a href={e.url}>{e.name}</a>
                </td>
                <td>{e.use}</td>
                <td>{e.licence}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))
}
