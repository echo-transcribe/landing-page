---
import { site } from '../../../config/site';
import { countryName } from '../../../i18n';

const { company, email } = site;
---

<section aria-labelledby="provider">
  <h2 id="provider">Prestador</h2>
  <p>
    {company.name}<br />
    {company.address}<br />
    {countryName('pt-br')}
  </p>
</section>

{
  company.regNo && (
    <section aria-labelledby="registration">
      <h2 id="registration">Registro</h2>
      <p>
        Registrado no {company.register}, n.º de registro {company.regNo}.
        {company.vatId && <><br />N.º de IVA: {company.vatId}</>}
      </p>
    </section>
  )
}

<section aria-labelledby="contact">
  <h2 id="contact">Contato</h2>
  <p>
    Geral: <a href={`mailto:${email.hello}`}>{email.hello}</a><br />
    Privacidade: <a href={`mailto:${email.privacy}`}>{email.privacy}</a>
  </p>
</section>

<section aria-labelledby="disputes">
  <h2 id="disputes">Litígios de consumo</h2>
  {/* keep in sync with site.legal.adr */}
  <p>Não estamos obrigados a participar de procedimentos extrajudiciais de resolução de litígios de consumo e não participamos deles. Se algo der errado, escreva para nós e resolveremos o assunto diretamente com você.</p>
</section>
