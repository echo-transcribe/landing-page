---
import { site } from '../../../config/site';

const { company, email, legal } = site;
---

<section aria-labelledby="provider">
  <h2 id="provider">Provider</h2>
  <p>
    {company.name}<br />
    {company.address}<br />
    {company.country}
  </p>
</section>

{
  company.regNo && (
    <section aria-labelledby="registration">
      <h2 id="registration">Registration</h2>
      <p>
        Registered in the {company.register}, registration no. {company.regNo}.
        {company.vatId && <><br />VAT ID: {company.vatId}</>}
      </p>
    </section>
  )
}

<section aria-labelledby="contact">
  <h2 id="contact">Contact</h2>
  <p>
    General: <a href={`mailto:${email.hello}`}>{email.hello}</a><br />
    Privacy: <a href={`mailto:${email.privacy}`}>{email.privacy}</a>
  </p>
</section>

<section aria-labelledby="disputes">
  <h2 id="disputes">Consumer disputes</h2>
  <p>{legal.adr}</p>
</section>
