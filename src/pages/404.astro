---
import BaseLayout from '../layouts/BaseLayout.astro';
import { defaultLocale, enabledLocales, localizePath, useDict } from '../i18n';

const t = useDict(defaultLocale);
const versions = enabledLocales.map((l) => ({ ...l, t: useDict(l.code) }));
---

<BaseLayout title={t.meta.notFound.title} description={t.meta.notFound.description} noindex locale={defaultLocale}>
  {
    versions.map((v) => (
      <section data-404={v.path} lang={v.htmlLang} hidden={v.code !== defaultLocale}>
        <p class="code">404</p>
        <h1>{v.t.notFound.heading}</h1>
        <p class="lead">{v.t.notFound.lead}</p>
        <a class="home" href={localizePath('/', v.code)}>{v.t.notFound.home}</a>
      </section>
    ))
  }
</BaseLayout>

<script>
  const prefix = location.pathname.split('/')[1]?.toLowerCase() ?? '';
  const match = prefix && document.querySelector<HTMLElement>(`[data-404="${CSS.escape(prefix)}"]`);
  if (match) {
    document.querySelectorAll<HTMLElement>('[data-404]').forEach((el) => (el.hidden = el !== match));
    document.documentElement.lang = match.lang;
    document.title = match.querySelector('h1')?.textContent ?? document.title;
  }
</script>

<style>
  section[hidden] {
    display: none;
  }
  section {
    max-width: 640px;
    margin: 0 auto;
    padding: 120px 24px 140px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }
  .code {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--accent-text);
  }
  h1 {
    margin: 0;
    font-size: clamp(36px, 5vw, 52px);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .lead {
    margin: 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--text-2);
  }
  .home {
    margin-top: 12px;
    display: inline-flex;
    align-items: center;
    height: 52px;
    padding: 0 26px;
    border-radius: 999px;
    background: var(--raised);
    color: var(--text-ctl);
    font-weight: 600;
    text-decoration: none;
    box-shadow: var(--hairline-strong);
  }
  .home:hover {
    color: var(--text);
  }
</style>
