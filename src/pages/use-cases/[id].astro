---
import type { GetStaticPaths } from 'astro';
import UseCasePage from '../../views/pages/UseCasePage.astro';
import { defaultLocale } from '../../i18n';
import { useCaseIds } from '../../i18n/pages';

export const getStaticPaths = (() => useCaseIds.map((id) => ({ params: { id }, props: { id } }))) satisfies GetStaticPaths;

const { id } = Astro.props;
---

<UseCasePage locale={defaultLocale} id={id} />
