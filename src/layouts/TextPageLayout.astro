---
import BaseLayout from './BaseLayout.astro';
import { site } from '../config/site';
import { formatDate, getLocale, useDict, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** Visible H1; defaults to the part of the title before " — ". */
  heading?: string;
  /** ISO date shown as "Last updated". */
  updated?: string;
  /** Legal text: shows a draft notice until site.legal.reviewed is true. */
  legal?: boolean;
  jsonLd?: object[];
  locale?: Locale;
  /** The unprefixed route, for hreflang links. */
  path?: string;
}

const { title, description, heading, updated, legal = false, jsonLd, path } = Astro.props;
const locale = Astro.props.locale ?? getLocale(Astro);
const t = useDict(locale);
const h1 = heading ?? title.split(' — ')[0];
const updatedLabel = updated ? formatDate(updated, locale) : null;
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} locale={locale} path={path}>
  <div class="page">
    <article class="prose">
      <header class="page-head">
        <h1>{h1}</h1>
        {updatedLabel && <p class="updated">{t.textPage.lastUpdated} <time datetime={updated}>{updatedLabel}</time></p>}
      </header>
      {
        legal && !site.legal.reviewed && (
          <p class="draft" role="note">{t.textPage.draftNotice}</p>
        )
      }
      <slot />
    </article>
  </div>
</BaseLayout>

<style>
  .page {
    padding: 64px 24px 104px;
  }
  .prose {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .page-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  h1 {
    margin: 0;
    font-size: clamp(36px, 5vw, 52px);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .updated {
    margin: 0;
    font-size: 15px;
    color: var(--text-2);
  }

  /* Content comes from page slots, so these rules reach it through :global. */
  .prose :global(section) {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .prose :global(h2) {
    margin: 0;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .prose :global(h3) {
    margin: 8px 0 0;
    font-size: 17px;
    font-weight: 600;
  }
  .prose :global(p),
  .prose :global(li) {
    margin: 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-ctl);
  }
  .prose :global(ul) {
    margin: 0;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 10px 12px 10px 0;
    border-bottom: 1px solid var(--rule);
    line-height: 1.5;
  }
  .prose :global(th) {
    font-weight: 600;
  }
  .prose :global(.table-wrap) {
    overflow-x: auto;
  }
  .prose :global(.summary) {
    border-radius: 18px;
    background: var(--sage-soft);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .prose :global(.summary h2) {
    font-size: 21px;
  }
  .prose :global(.summary ul) {
    padding: 0;
    list-style: none;
    gap: 10px;
  }
  /* Not flex: items mix text and links, which flex would split into columns. */
  .prose :global(.summary li) {
    position: relative;
    padding-left: 26px;
    line-height: 1.55;
  }
  .prose :global(.summary li)::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--success);
    font-weight: 700;
  }
  .draft {
    margin: 0;
    padding: 16px 18px;
    border-radius: 12px;
    background: var(--cream);
    color: var(--accent-text);
    font-size: 14px;
    line-height: 1.5;
  }

  @media (max-width: 700px) {
    .page {
      padding: 40px 20px 72px;
    }
    .prose :global(.summary) {
      padding: 22px;
    }
  }
</style>
